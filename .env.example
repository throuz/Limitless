# =====================================================
# polymkt 環境變數設定
# 複製本檔為 .env，填入真實值。.env 已在 .gitignore 內。
# =====================================================

# ---------- Limitless Exchange（Base 鏈，台灣可用）----------

# HMAC API token — 用 `polymkt limitless auth-derive` 換到
LIMITLESS_API_TOKEN_ID=
LIMITLESS_API_SECRET=

# 簽署訂單用的 EOA 私鑰。注意：
# - 雖然變數名稱叫 POLYGON_PRIVATE_KEY（歷史相容），但 Limitless 在 Base 鏈
# - 同一個私鑰可用於 Polygon 與 Base（同一個 EOA 位址）
# - 要先把 USDC bridge 到 Base 才能下單
# - 建議：用獨立 wallet 只放下單需要金額；絕對不要用主錢包
POLYGON_PRIVATE_KEY=
# 等價別名（之後二選一即可）
# BASE_PRIVATE_KEY=

# ---------- 安全限額 ----------

# 單筆訂單最大 USDC（預設 $50）
LIMITLESS_MAX_PER_ORDER=50

# 整個會話累計上限（預設 $500）
LIMITLESS_MAX_PER_SESSION=500

# 必須設為 "1" 才真實下單；否則所有訂單只是 dry-run
LIMITLESS_EXECUTE=0

# ---------- Polymarket（讀取分析用，台灣 close-only）----------

GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com

# ---------- 掃描參數 ----------

MIN_LIQUIDITY=1000
MIN_EDGE_BPS=50
MAX_MARKETS=500
